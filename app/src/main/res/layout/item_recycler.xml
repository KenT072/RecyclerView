<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="8dp">


    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="8dp"
        android:scaleType="fitCenter"
        android:id="@+id/gambarWayang"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@android:drawable/ic_menu_gallery"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/namaWayang"
        app:layout_constraintStart_toEndOf="@id/gambarWayang"
        app:layout_constraintEnd_toStartOf="@id/btnHapus"
        app:layout_constraintTop_toTopOf="@id/gambarWayang"
        tools:text="Nama Wayang"/>
    
    <TextView
        android:id="@+id/karakterWayang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/namaWayang"
        app:layout_constraintEnd_toStartOf="@id/btnHapus"
        app:layout_constraintTop_toBottomOf="@id/namaWayang"
        tools:text="Karakter Wayang" />

    <TextView
        android:id="@+id/deskripsiWayang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/namaWayang"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/karakterWayang"
        tools:text="Deskripsi Wayang" />

    <Button
        android:id="@+id/btnHapus"
        android:layout_width="52dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:text="Hapus"
        android:textAllCaps="false"
        android:textColor="#B3261E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/namaWayang"
        app:layout_constraintBottom_toBottomOf="@id/karakterWayang" />


</androidx.constraintlayout.widget.ConstraintLayout>